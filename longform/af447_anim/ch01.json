     "size": 0.042,
     "color": "#ffffff",
     "bg": "#14181f",
     "bg_alpha": 0.9,
     "style": "label",
     "stroke": false,
     "enter": "pop",
     "at": 0.2
    }
   ],
   "id": "s7"
  },
  {
   "narration": "Then in April 2011, a sonar search finds the wreck almost four kilometres down. Both recorders still work.",
   "background": {
