     "stroke": false,
     "enter": "pop",
     "at_word": "survives."
    }
   ],
   "id": "s6"
  },
  {
   "narration": "Wreckage is found within days. The black boxes are not.",
   "background": {
    "type": "world3d"
   },
   "elements": [
    {
     "type": "text",
     "text": "June 2009: the search",
     "x": 0.5,
