  {
   "narration": "ऋषियों की सलाह पर दशरथ ने पुत्रकामेष्टि यज्ञ किया। यज्ञ की अग्नि से एक दिव्य पुरुष प्रकट हुए, और राजा को खीर से भरा एक पात्र दिया।",
   "background": {
    "type": "footage",
    "image_id": 237699,
    "move": "in",
    "dim": 0.12,
    "fallback": {
     "type": "gradient",
     "colors": [
