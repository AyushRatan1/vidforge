     ]
    }
   },
   "elements": [],
   "id": "ch01_01"
  },
  {
   "narration": "यह कहानी हज़ारों सालों से सुनाई जा रही है। रामायण फिल्म का पहला भाग अभी सिनेमाघरों में आया है, और दूसरा भाग दो हज़ार अट्ठाईस में आएगा।",
   "background": {
    "type": "footage",
    "image_id": 6133619,
    "move": "out",
    "dim": 0.12,
    "fallback": {
     "type": "gradient",
     "colors": [
      "#2a1a0e",
      "#120a05"
     ]
    }
   },
   "elements": [],
   "id": "ch01_02"
  },
  {
   "narration": "लेकिन असली कहानी जानने के लिए इंतज़ार की ज़रूरत नहीं। आज, वाल्मीकि रामायण के आधार पर, शुरू से अंत तक, पूरी कहानी।",
   "background": {
    "type": "footage",
    "image_id": 419589,
    "move": "left",
    "dim": 0.12,
    "fallback": {
     "type": "gradient",
     "colors": [
      "#2a1a0e",
      "#120a05"
     ]
    }
   },
   "elements": [
    {
     "type": "text",
     "text": "वाल्मीकि रामायण",
     "x": 0.5,
     "y": 0.13,
     "size": 0.026,
     "color": "#ffffff",
     "bg": "#1c1a17",
     "bg_alpha": 0.78,
     "style": "label",
     "stroke": false,
     "enter": "fade",
     "at_word": "वाल्मीकि"
    }
   ],
   "id": "ch01_03"
  },
  {
   "narration": "सरयू नदी के किनारे बसी थी अयोध्या, कोसल राज्य की राजधानी। यहाँ के राजा थे दशरथ, वीर, धर्मात्मा और प्रजा के प्रिय।",
