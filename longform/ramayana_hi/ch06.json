      "#120a05"
     ]
    }
   },
   "elements": [
    {
     "type": "text",
     "text": "अध्याय 6: लंका दहन",
     "x": 0.5,
     "y": 0.13,
     "size": 0.034,
     "color": "#1c1a17",
     "bg": "#ffd54a",
     "style": "label",
     "stroke": false,
     "enter": "pop",
     "at": 0.2,
     "until": 4.5
    }
   ],
   "id": "ch06_01"
  },
  {
   "narration": "रास्ते में समुद्र से मैनाक पर्वत ऊपर उठा, ताकि हनुमान थोड़ा विश्राम कर लें। पर हनुमान ने धन्यवाद कहा, और रुके बिना आगे बढ़ गए।",
   "background": {
    "type": "footage",
    "image_id": 3473335,
    "move": "left",
    "dim": 0.12,
    "fallback": {
     "type": "gradient",
     "colors": [
      "#2a1a0e",
      "#120a05"
     ]
    }
   },
   "elements": [],
   "id": "ch06_02"
  },
  {
   "narration": "फिर नागमाता सुरसा ने उनका रास्ता रोका। हनुमान ने चतुराई से अपना रूप छोटा किया, उसके मुँह में जाकर तुरंत बाहर निकल आए, और आगे बढ़ गए।",
   "background": {
    "type": "footage",
    "query": "ocean storm waves",
    "dim": 0.18,
    "fallback": {
     "type": "gradient",
     "colors": [
      "#2a1a0e",
      "#120a05"
     ]
    }
   },
   "elements": [],
   "id": "ch06_03"
  },
  {
   "narration": "आगे समुद्र में छिपी राक्षसी सिंहिका ने उनकी परछाईं पकड़कर उन्हें खींच लिया। हनुमान ने उसका भी अंत कर दिया।",
   "background": {
    "type": "footage",
    "image_id": 685303,
    "move": "in",
    "dim": 0.12,
    "fallback": {
     "type": "gradient",
     "colors": [
      "#2a1a0e",
      "#120a05"
     ]
    }
   },
   "elements": [],
   "id": "ch06_04"
  },
  {
   "narration": "लंका के द्वार पर नगर की रक्षक लंकिनी ने उन्हें रोका। हनुमान के एक मुक्के से वह गिर पड़ी, और बोली: ब्रह्मा ने कहा था, जब एक वानर मुझे हरा देगा, तब लंका का अंत निकट होगा।",
   "background": {
    "type": "footage",
    "image_id": 1103141,
    "move": "in",
    "dim": 0.12,
    "fallback": {
     "type": "gradient",
     "colors": [
      "#2a1a0e",
      "#120a05"
     ]
    }
   },
   "elements": [
    {
     "type": "text",
     "text": "लंकिनी",
     "x": 0.5,
     "y": 0.13,
     "size": 0.026,
     "color": "#ffffff",
     "bg": "#1c1a17",
     "bg_alpha": 0.78,
     "style": "label",
     "stroke": false,
     "enter": "fade",
     "at_word": "लंकिनी"
    }
   ],
   "id": "ch06_05"
  },
  {
   "narration": "सामने थी सोने की लंका। रात में छोटा रूप धरकर हनुमान ने महल महल खोजा।",
   "background": {
    "type": "footage",
    "image_id": 5579991,
    "move": "left",
    "dim": 0.12,
    "fallback": {
     "type": "gradient",
     "colors": [
      "#2a1a0e",
      "#120a05"
     ]
    }
   },
   "elements": [],
   "id": "ch06_06"
  },
  {
   "narration": "एक महल में हनुमान ने एक सुंदर रानी को सोते देखा, और एक पल को लगा कि यही सीता हैं। फिर समझ आया: राम से दूर सीता ऐसे सुख में नहीं सो सकतीं। वह रावण की पत्नी मंदोदरी थीं।",
   "background": {
    "type": "footage",
    "image_id": 653180,
    "move": "left",
    "dim": 0.12,
    "fallback": {
     "type": "gradient",
     "colors": [
      "#2a1a0e",
      "#120a05"
     ]
    }
   },
   "elements": [],
   "id": "ch06_07"
  },
  {
   "narration": "आखिर अशोक वाटिका में, एक पेड़ के नीचे, राक्षसियों से घिरी, उदास सीता दिखाई दीं।",
   "background": {
    "type": "footage",
    "image_id": 5114501,
    "move": "in",
    "dim": 0.12,
    "fallback": {
     "type": "gradient",
     "colors": [
      "#2a1a0e",
      "#120a05"
     ]
    }
   },
   "elements": [
    {
     "type": "text",
     "text": "अशोक वाटिका",
     "x": 0.5,
     "y": 0.13,
     "size": 0.026,
     "color": "#ffffff",
     "bg": "#1c1a17",
     "bg_alpha": 0.78,
     "style": "label",
     "stroke": false,
     "enter": "fade",
     "at_word": "अशोक"
    }
   ],
   "id": "ch06_08"
  },
  {
   "narration": "हनुमान पेड़ पर छिपकर देखते रहे। रावण आया, और सीता को डराया, धमकाया। पर सीता ने एक तिनके की ओट से उसे जवाब दिया: मैं केवल राम की हूँ।",
   "background": {
    "type": "footage",
    "query": "tree leaves night moon",
    "dim": 0.18,
    "fallback": {
     "type": "gradient",
     "colors": [
      "#2a1a0e",
      "#120a05"
     ]
    }
   },
   "elements": [],
   "id": "ch06_09"
  },
  {
   "narration": "रावण के जाने के बाद, सीता का विश्वास जीतने के लिए हनुमान ने पेड़ पर बैठे बैठे धीरे से राम की कथा सुनानी शुरू की।",
   "background": {
    "type": "footage",
    "image_id": 8510043,
    "move": "in",
    "dim": 0.12,
    "fallback": {
     "type": "gradient",
     "colors": [
      "#2a1a0e",
      "#120a05"
     ]
    }
   },
   "elements": [],
   "id": "ch06_10"
  },
  {
   "narration": "फिर हनुमान नीचे आए, और राम की अंगूठी दी। उसे देखते ही सीता की आँखें भर आईं।",
   "background": {
    "type": "footage",
    "image_id": 3762690,
    "move": "in",
    "dim": 0.12,
    "fallback": {
     "type": "gradient",
     "colors": [
      "#2a1a0e",
      "#120a05"
     ]
    }
   },
   "elements": [],
   "id": "ch06_11"
  },
  {
   "narration": "हनुमान बोले: माता, मेरी पीठ पर बैठिए, मैं अभी आपको राम के पास ले चलता हूँ। पर सीता ने मना कर दिया: रावण को उसके किए की सज़ा राम ही देंगे।",
   "background": {
    "type": "footage",
    "image_id": 2803390,
    "move": "in",
    "dim": 0.12,
    "fallback": {
     "type": "gradient",
     "colors": [
      "#2a1a0e",
      "#120a05"
     ]
    }
   },
   "elements": [],
   "id": "ch06_12"
  },
  {
   "narration": "सीता ने अपनी चूड़ामणि हनुमान को सौंपी, राम के लिए निशानी के तौर पर।",
   "background": {
    "type": "footage",
    "image_id": 19436,
    "move": "in",
    "dim": 0.12,
    "fallback": {
     "type": "gradient",
     "colors": [
      "#2a1a0e",
      "#120a05"
     ]
    }
   },
   "elements": [
    {
     "type": "text",
     "text": "चूड़ामणि",
     "x": 0.5,
     "y": 0.13,
     "size": 0.026,
     "color": "#ffffff",
     "bg": "#1c1a17",
     "bg_alpha": 0.78,
     "style": "label",
     "stroke": false,
     "enter": "fade",
     "at_word": "चूड़ामणि"
    }
   ],
   "id": "ch06_13"
  },
  {
   "narration": "फिर हनुमान ने जानबूझकर अशोक वाटिका उजाड़ दी। रावण के सैनिक आए, और रावण के पुत्र मेघनाद ने उन्हें ब्रह्मास्त्र से बाँधकर दरबार में पेश किया।",
   "background": {
    "type": "footage",
    "image_id": 1807557,
    "move": "in",
    "dim": 0.12,
    "fallback": {
     "type": "gradient",
     "colors": [
      "#2a1a0e",
      "#120a05"
     ]
    }
   },
   "elements": [],
   "id": "ch06_14"
  },
  {
   "narration": "दरबार में हनुमान ने रावण को चेतावनी दी: सीता को लौटा दो। क्रोधित रावण ने हनुमान की पूँछ में आग लगाने का आदेश दिया।",
   "background": {
    "type": "footage",
    "image_id": 2803401,
    "move": "out",
    "dim": 0.12,
    "fallback": {
     "type": "gradient",
     "colors": [
      "#2a1a0e",
      "#120a05"
     ]
    }
   },
   "elements": [],
   "id": "ch06_15"
  },
  {
   "narration": "और यही उसकी सबसे बड़ी भूल थी। जलती पूँछ के साथ हनुमान एक महल से दूसरे महल पर कूदते गए, और पूरी लंका धू धू कर जलने लगी।",
   "background": {
    "type": "footage",
    "image_id": 9877220,
    "move": "up",
    "dim": 0.12,
    "fallback": {
     "type": "gradient",
     "colors": [
      "#2a1a0e",
      "#120a05"
     ]
    }
   },
   "elements": [],
   "id": "ch06_16"
  },
  {
   "narration": "समुद्र में पूँछ की आग बुझाकर हनुमान लौटे, और राम को खबर दी: सीता जीवित हैं, और आपकी राह देख रही हैं।",
   "background": {
    "type": "footage",
    "query": "sunrise ocean",
    "dim": 0.18,
    "fallback": {
     "type": "gradient",
     "colors": [
      "#2a1a0e",
      "#120a05"
     ]
    }
   },
   "elements": [],
   "id": "ch06_17"
  },
  {
   "narration": "चूड़ामणि देखते ही राम की आँखों से आँसू बह निकले। अब देर नहीं थी। वानर सेना लंका की ओर कूच के लिए तैयार हो गई।",
