 "scenes": [
  {
   "narration": "लंका में रावण के छोटे भाई विभीषण ने उसे समझाया कि सीता को लौटा दो। रावण ने उन्हें अपमानित करके निकाल दिया, और विभीषण राम की शरण में आ गए।",
   "background": {
