   ],
   "id": "ch07_01"
  },
  {
   "narration": "युद्ध से पहले राम ने युवराज अंगद को दूत बनाकर रावण के पास भेजा, ताकि सीता को लौटाकर युद्ध टाला जा सके। पर रावण नहीं माना।",
   "background": {
    "type": "footage",
    "image_id": 639103,
    "move": "in",
    "dim": 0.12,
    "fallback": {
     "type": "gradient",
     "colors": [
      "#2a1a0e",
      "#120a05"
     ]
    }
   },
   "elements": [
    {
     "type": "text",
     "text": "अंगद, शांति दूत",
     "x": 0.5,
     "y": 0.13,
     "size": 0.026,
     "color": "#ffffff",
     "bg": "#1c1a17",
     "bg_alpha": 0.78,
     "style": "label",
     "stroke": false,
     "enter": "fade",
     "at_word": "अंगद"
    }
   ],
   "id": "ch07_02"
  },
  {
   "narration": "अब सेना को समुद्र पार करना था। वानर नल के नेतृत्व में, पत्थरों और पेड़ों से समुद्र पर एक पुल बनाया गया: राम सेतु।",
   "background": {
    "type": "world3d"
   },
   "elements": [
    {
     "type": "text",
     "text": "राम सेतु",
     "x": 0.5,
     "y": 0.13,
     "size": 0.026,
     "color": "#ffffff",
     "bg": "#1c1a17",
     "bg_alpha": 0.78,
     "style": "label",
     "stroke": false,
     "enter": "fade",
     "at_word": "सेतु।"
    }
   ],
   "id": "setu"
  },
  {
   "narration": "वाल्मीकि लिखते हैं कि यह सेतु पाँच दिनों में बना। और उस पर चलकर वानर सेना लंका पहुँच गई।",
   "background": {
    "type": "world3d"
   },
   "elements": [
    {
     "type": "text",
     "text": "5 दिन",
     "x": 0.5,
     "y": 0.13,
     "size": 0.026,
     "color": "#ffffff",
     "bg": "#1c1a17",
     "bg_alpha": 0.78,
     "style": "label",
     "stroke": false,
     "enter": "fade",
     "at_word": "पाँच"
    }
   ],
   "id": "setu2"
  },
  {
   "narration": "भीषण युद्ध शुरू हुआ। रावण ने अपने विशाल भाई कुंभकर्ण को गहरी नींद से जगाया। वह हज़ारों वानरों पर भारी पड़ा, पर अंत में राम के बाणों से गिर गया।",
   "background": {
    "type": "footage",
    "image_id": 4779546,
    "move": "in",
    "dim": 0.12,
    "fallback": {
     "type": "gradient",
     "colors": [
      "#2a1a0e",
      "#120a05"
     ]
    }
   },
   "elements": [
    {
     "type": "text",
     "text": "कुंभकर्ण",
     "x": 0.5,
     "y": 0.13,
     "size": 0.026,
     "color": "#ffffff",
     "bg": "#1c1a17",
     "bg_alpha": 0.78,
     "style": "label",
     "stroke": false,
     "enter": "fade",
     "at_word": "कुंभकर्ण"
    }
   ],
   "id": "ch07_05"
  },
  {
   "narration": "फिर आया मेघनाद, जिसने कभी इंद्र को भी हराया था। उसकी शक्ति के प्रहार से लक्ष्मण मूर्छित होकर गिर पड़े।",
   "background": {
    "type": "footage",
    "image_id": 9252312,
    "move": "out",
    "dim": 0.12,
    "fallback": {
     "type": "gradient",
     "colors": [
      "#2a1a0e",
      "#120a05"
     ]
    }
   },
   "elements": [
    {
     "type": "text",
     "text": "मेघनाद",
     "x": 0.5,
     "y": 0.13,
     "size": 0.026,
     "color": "#ffffff",
     "bg": "#1c1a17",
     "bg_alpha": 0.78,
     "style": "label",
     "stroke": false,
     "enter": "fade",
     "at_word": "मेघनाद,"
    }
   ],
   "id": "ch07_06"
  },
  {
   "narration": "वैद्य सुषेण ने कहा: हिमालय की संजीवनी बूटी चाहिए। हनुमान उड़े, पर बूटी पहचान नहीं पाए, तो पूरा पर्वत ही उठा लाए।",
   "background": {
    "type": "footage",
    "image_id": 4702174,
    "move": "up",
    "dim": 0.12,
    "fallback": {
     "type": "gradient",
     "colors": [
      "#2a1a0e",
      "#120a05"
     ]
    }
   },
   "elements": [
    {
     "type": "text",
     "text": "संजीवनी",
     "x": 0.5,
     "y": 0.13,
     "size": 0.026,
     "color": "#ffffff",
     "bg": "#1c1a17",
     "bg_alpha": 0.78,
     "style": "label",
     "stroke": false,
     "enter": "fade",
     "at_word": "संजीवनी"
    }
   ],
   "id": "ch07_07"
  },
  {
   "narration": "लक्ष्मण होश में आए, और अगले युद्ध में उन्होंने मेघनाद का वध कर दिया।",
   "background": {
    "type": "footage",
    "image_id": 9252305,
    "move": "in",
    "dim": 0.12,
    "fallback": {
     "type": "gradient",
     "colors": [
      "#2a1a0e",
      "#120a05"
     ]
    }
   },
   "elements": [],
   "id": "ch07_08"
  },
  {
   "narration": "अब बचा था सिर्फ रावण। राम और रावण का युद्ध कई दिनों तक चला। राम रावण का सिर काटते, और वह फिर उग आता।",
   "background": {
    "type": "footage",
    "image_id": 8916905,
    "move": "in",
    "dim": 0.12,
    "fallback": {
     "type": "gradient",
     "colors": [
      "#2a1a0e",
      "#120a05"
     ]
    }
   },
   "elements": [],
   "id": "ch07_09"
  },
  {
   "narration": "तब सारथी मातलि ने राम को ब्रह्मास्त्र की याद दिलाई। राम ने ब्रह्मास्त्र चलाया, बाण रावण के हृदय में लगा, और लंका का राजा धराशायी हो गया।",
   "background": {
