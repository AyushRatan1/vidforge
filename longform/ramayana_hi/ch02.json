 "scenes": [
  {
   "narration": "एक दिन महर्षि विश्वामित्र अयोध्या आए। उनके यज्ञ को राक्षस बार बार नष्ट कर रहे थे। रक्षा के लिए उन्होंने राजा से राम को माँगा।",
   "background": {
