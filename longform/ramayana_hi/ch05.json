   "id": "ch05_01"
  },
  {
   "narration": "शबरी बरसों से राम की राह देख रही थीं। लोक परंपरा कहती है कि उन्होंने चख चखकर सबसे मीठे बेर राम को खिलाए।",
   "background": {
    "type": "footage",
    "image_id": 3855529,
    "move": "right",
    "dim": 0.12,
    "fallback": {
     "type": "gradient",
     "colors": [
      "#2a1a0e",
      "#120a05"
     ]
    }
   },
   "elements": [],
   "id": "ch05_02"
  },
  {
   "narration": "ऋष्यमूक पर सुग्रीव ने दो धनुर्धारियों को आते देखा, तो डर गए। उन्होंने अपने मंत्री हनुमान को भेजा, जो साधु का वेश धरकर राम के पास आए।",
   "background": {
    "type": "footage",
    "image_id": 5998491,
    "move": "in",
    "dim": 0.12,
    "fallback": {
     "type": "gradient",
     "colors": [
      "#2a1a0e",
      "#120a05"
     ]
    }
   },
   "elements": [],
   "id": "ch05_03"
  },
  {
   "narration": "हनुमान की मधुर और विनम्र वाणी से राम बहुत प्रभावित हुए। पवनपुत्र हनुमान उसी क्षण से राम के सबसे बड़े भक्त बन गए।",
   "background": {
    "type": "footage",
    "image_id": 8797246,
    "move": "out",
    "dim": 0.12,
    "fallback": {
     "type": "gradient",
     "colors": [
      "#2a1a0e",
      "#120a05"
     ]
    }
   },
   "elements": [
    {
     "type": "text",
     "text": "हनुमान",
     "x": 0.5,
     "y": 0.13,
     "size": 0.026,
     "color": "#ffffff",
