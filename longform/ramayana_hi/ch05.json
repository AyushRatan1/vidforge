  {
   "narration": "सुग्रीव किष्किंधा के राजा बने। बारिश के चार महीने राम ने प्रवर्षण पर्वत पर बिताए। सुग्रीव राजसुख में वादा भूल गए, तो लक्ष्मण क्रोध में किष्किंधा पहुँचे।",
   "background": {
    "type": "footage",
    "image_id": 3194001,
    "move": "in",
    "dim": 0.12,
    "fallback": {
     "type": "gradient",
     "colors": [
      "#2a1a0e",
      "#120a05"
     ]
    }
   },
   "elements": [],
   "id": "ch05_08"
  },
  {
   "narration": "तब सुग्रीव ने वानर सेना को चारों दिशाओं में सीता की खोज में भेजा। राम ने हनुमान को अपनी अंगूठी दी, ताकि सीता उन्हें पहचान सकें।",
   "background": {
