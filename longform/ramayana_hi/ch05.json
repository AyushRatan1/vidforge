   "elements": [],
   "id": "ch05_10"
  },
  {
   "narration": "सामने था विशाल समुद्र। कौन जाएगा? तब जामवंत ने हनुमान को उनकी भूली हुई शक्ति याद दिलाई।",
   "background": {
    "type": "footage",
    "query": "ocean horizon sunset",
    "dim": 0.18,
    "fallback": {
