   "elements": [
    {
     "type": "text",
     "text": "11:30 pm: the gate opens",
     "x": 0.5,
     "y": 0.13,
     "size": 0.026,
     "color": "#ffffff",
     "bg": "#1c1a17",
     "bg_alpha": 0.78,
