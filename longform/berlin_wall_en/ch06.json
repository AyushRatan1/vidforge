     "at_word": "eleven,"
    }
   ],
   "id": "ch06_02"
  },
  {
   "narration": "One by one, the other crossings opened. Strangers hugged, cried and shared drinks. West Berliners greeted the East with flowers and applause.",
   "background": {
    "type": "footage",
    "image_id": 3387324,
    "move": "in",
    "dim": 0.14,
    "fallback": {
     "type": "gradient",
