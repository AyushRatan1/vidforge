      "#0d0b09"
     ]
    }
   },
   "elements": [],
   "id": "ch06_03"
  },
  {
   "narration": "Before long, people were dancing on top of the Wall at the Brandenburg Gate, the very place where, a year earlier, guards would have shot them.",
   "background": {
    "type": "footage",
    "image_id": 417890,
    "move": "out",
    "dim": 0.14,
    "fallback": {
     "type": "gradient",
