    }
   },
   "elements": [
    {
     "type": "text",
     "text": "155 km around West Berlin",
     "x": 0.5,
     "y": 0.13,
     "size": 0.026,
     "color": "#ffffff",
     "bg": "#1c1a17",
     "bg_alpha": 0.78,
     "style": "label",
     "stroke": false,
     "enter": "fade",
     "at_word": "155"
    }
   ],
   "id": "ch02_02"
  },
  {
   "narration": "The final version was made of prefabricated concrete slabs about three and a half metres high, topped with a smooth round pipe so that nobody could get a grip.",
   "background": {
    "type": "footage",
    "image_id": 113173,
    "move": "up",
    "dim": 0.14,
    "fallback": {
     "type": "gradient",
     "colors": [
      "#1d1a17",
      "#0d0b09"
     ]
    }
   },
   "elements": [],
   "id": "ch02_03"
  },
  {
   "narration": "Behind it lay the death strip: raked sand that showed every footprint, trip wires, anti-vehicle trenches, guard dogs, and floodlights that turned night into day.",
   "background": {
    "type": "footage",
    "image_id": 3347052,
    "move": "in",
    "dim": 0.14,
    "fallback": {
     "type": "gradient",
     "colors": [
      "#1d1a17",
      "#0d0b09"
     ]
    }
   },
   "elements": [
    {
     "type": "text",
     "text": "The death strip",
     "x": 0.5,
     "y": 0.13,
     "size": 0.026,
     "color": "#ffffff",
     "bg": "#1c1a17",
     "bg_alpha": 0.78,
     "style": "label",
