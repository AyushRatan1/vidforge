    "fallback": {
     "type": "gradient",
     "colors": [
      "#1d1a17",
      "#0d0b09"
     ]
    }
   },
   "elements": [],
   "id": "ch03_03"
  },
  {
   "narration": "पर सर्दियों की रातों में ज़मीन जल्दी ठंडी हो जाती है, और ऊपर गर्म हवा की एक परत बन जाती है, जैसे किसी ने ढक्कन लगा दिया हो। धुआँ नीचे ही कैद रह जाता है।",
   "background": {
