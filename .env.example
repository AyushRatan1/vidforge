# Copy to .env and fill in. Never commit .env.

# Dashboard login (required whenever the app is reachable from the internet)
VIDFORGE_USER=admin
VIDFORGE_PASSWORD=change-me-to-something-long

# Public address of the dashboard (used for the YouTube OAuth redirect) and the domain Caddy serves
PUBLIC_URL=https://studio.example.com
DOMAIN=studio.example.com

# Optional: keys can also be entered in the dashboard (stored encrypted in data/)
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
NASA_API_KEY=
